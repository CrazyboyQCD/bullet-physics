/target

# Host-specific cargo config (MSVC linker pin). Recreate it locally when cargo
# fails to link on Windows — see docs/agent-setup.md §2. Kept out of the
# repository on purpose.
/.cargo/

# Parity harness build artifacts
/tools/*.exe
/tools/*.obj

# For implementation reference
/refs/bullet3/
# Python bytecode
/tools/__pycache__/

# Parity scene tables are generated from tools/scenes.json (single source of truth)
/tools/bullet_scenes.h
/crates/bullet/src/parity_scenes.rs

# Perf scene tables are generated from tools/perf_scenes.json (single source of truth)
/tools/bullet_perf_scenes.h
/crates/bullet/src/perf_scenes_table.rs

/tools/_vcvars_env.bat

# Local agent handoff notes, not part of the published repo
/HANDOFF.md

# Browser demo build output (regenerate with tools/wasm-demo/build.py)
/tools/wasm-demo/dist/
